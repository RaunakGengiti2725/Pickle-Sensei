{
  "name": "pickle-sensei",
  "private": true,
  "version": "0.1.0",
  "description": "AI pickleball coaching platform — monorepo",
  "engines": {
    "node": ">=20 <21"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @pickle/database migrate",
    "db:seed": "pnpm --filter @pickle/database seed",
    "dev:api": "pnpm --filter @pickle/api dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
