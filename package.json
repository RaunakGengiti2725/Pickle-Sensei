{
  "name": "pickle-sensei",
  "private": true,
  "version": "0.1.0",
  "description": "AI pickleball coaching platform — monorepo",
  "engines": {
    "node": ">=20 <21"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @pickle/database migrate",
    "db:seed": "pnpm --filter @pickle/database seed",
    "dev:api": "pnpm --filter @pickle/api dev",
    "eval:vision": "pnpm --filter @pickle/vision-geometry eval",
    "eval:scoring": "pnpm --filter @pickle/vision-geometry eval",
    "eval:all": "pnpm --filter @pickle/vision-geometry eval",
    "lab:analyze": "pnpm --filter @pickle/swing-lab analyze:video",
    "lab:annotate": "pnpm --filter @pickle/swing-lab annotate",
    "lab:export": "pnpm --filter @pickle/swing-lab dataset:export",
    "lab:paddle-bench": "pnpm --filter @pickle/swing-lab paddle:bench",
    "lab:ball-bench": "pnpm --filter @pickle/swing-lab ball:bench",
    "lab:stroke-bench": "pnpm --filter @pickle/swing-lab stroke:bench",
    "lab:stroke-taxonomy": "pnpm --filter @pickle/swing-lab stroke:taxonomy",
    "lab:dataset-report": "pnpm --filter @pickle/swing-lab dataset:report",
    "lab:dataset-release": "pnpm --filter @pickle/swing-lab dataset:release",
    "lab:data-gaps": "pnpm --filter @pickle/swing-lab data:gaps",
    "lab:mine": "pnpm --filter @pickle/swing-lab mine",
    "lab:paddle-waterfall": "pnpm --filter @pickle/swing-lab paddle:waterfall",
    "lab:acquire": "pnpm --filter @pickle/swing-lab acquire",
    "lab:corpus-init": "pnpm --filter @pickle/swing-lab corpus:init",
    "lab:corpus-status": "pnpm --filter @pickle/swing-lab corpus:status",
    "lab:factory": "pnpm --filter @pickle/swing-lab factory",
    "lab:ta-bench": "pnpm --filter @pickle/swing-lab ta:bench",
    "lab:learning-curve": "pnpm --filter @pickle/swing-lab learning:curve",
    "lab:learning-curve-modality": "pnpm --filter @pickle/swing-lab learning:curve-modality",
    "lab:corpus-sessions": "pnpm --filter @pickle/swing-lab corpus:sessions",
    "lab:failure-mine": "pnpm --filter @pickle/swing-lab failure:mine",
    "lab:own": "pnpm --filter @pickle/swing-lab own",
    "lab:completion-bench": "pnpm --filter @pickle/swing-lab completion:bench",
    "lab:cascade": "pnpm --filter @pickle/swing-lab cascade",
    "lab:coach-queue": "pnpm --filter @pickle/swing-lab coach:queue",
    "lab:regen": "pnpm --filter @pickle/swing-lab regen",
    "lab:risk-curves": "pnpm --filter @pickle/swing-lab risk:curves",
    "lab:label-queue": "pnpm --filter @pickle/swing-lab label:queue",
    "lab:label-queue-v3": "pnpm --filter @pickle/swing-lab label:queue-v3",
    "lab:bundle": "pnpm --filter @pickle/swing-lab bundle:experiments"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
