# research tooling environments + native build artifacts (re-derivable)
tools/paddle-lab/.venv/
native/swing-lab/.build/
# rendered overlay videos are re-derivable from run artifacts (lab:analyze --overlay)
datasets/**/overlay.mp4
# experiment sandboxes are copies of canonical run dirs (re-derivable via lab:regen);
# loose measurement/summary JSONs inside *-runs/ ARE committed.
datasets/experiments/*/*-runs/*/
datasets/experiments/*/*-runs-abcheck/*/
datasets/experiments/wave-b/merge-check/
# W12 probe frame renders (visual-truth/manifest/report JSONs ARE committed)
datasets/experiments/wave-b/W12-probe/frames/
datasets/experiments/wave-b/W12-probe/grids/
datasets/experiments/wave-b/W12-probe/truthviz/
# annotation-review frame renders are re-renderable (lab:own propose / render
# tooling); verdicts, sidecars, and queue JSONs ARE committed.
datasets/paddle-bench/ownership-review/*.png
datasets/experiments/wave-a/frames/
datasets/experiments/wave-a/slices/
tools/latency-bench/.venv-pose/
tools/latency-bench/*.task
