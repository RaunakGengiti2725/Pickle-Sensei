require "json"

default_platform(:ios)

# The release identity (MARKETING_VERSION / CURRENT_PROJECT_VERSION) is COMMITTED
# in the Xcode project and mirrored by infra/release/release-manifest.json; it is
# verified before anything is archived and re-read from the archive before
# anything is uploaded. No lane here chooses, bumps or overrides a build number:
# when the committed identity cannot ship, the lane refuses and the owner commits
# a new identity (docs/DISTRIBUTION.md, "Release identity").

platform :ios do
  desc "Build a signed release archive (Mac-only) from the committed release identity"
  lane :build do |options|
    identity = release_identity(latest_uploaded: options[:latest_uploaded])

    prep_signing unless lane_context[SharedValues::SIGH_PROFILE_PATHS]&.any?

    key_filepath = ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]
    xcargs = []
    if key_filepath
      xcargs += [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{File.expand_path(key_filepath).shellescape}",
        "-authenticationKeyID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_KEY_ID').shellescape}",
        "-authenticationKeyIssuerID #{ENV.fetch('APP_STORE_CONNECT_API_KEY_ISSUER_ID').shellescape}",
      ]
    end
    build_app(
      workspace: "PickleSensei.xcworkspace",
      scheme: "PickleSensei",
      configuration: "Release",
      output_directory: "build",
      xcargs: xcargs.join(" "),
      export_options: {
        method: "app-store-connect",
        destination: "export",
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
      },
    )

    verify_archive_identity(identity: identity)
  end

  desc "Refuse unless the committed identity is coherent (and newer than the newest uploaded build)"
  private_lane :release_identity do |options|
    script = File.expand_path("../../scripts/release-identity.mjs", __dir__)
    args = ["--check", "--require-committed", "--json"]
    unless options[:latest_uploaded].nil?
      args += ["--latest-uploaded", options[:latest_uploaded].to_s]
    end
    output = sh("node", script, *args, log: false)
    identity = JSON.parse(output.lines.reverse.find { |line| line.start_with?("{") })
    UI.success(
      "release identity #{identity['marketingVersion']} (#{identity['buildNumber']}) " \
      "#{identity['bundleIdentifier']} committed at #{identity['gitSha']}",
    )
    identity
  end

  desc "Refuse to continue unless the archive carries exactly the verified identity"
  private_lane :verify_archive_identity do |options|
    archive = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    UI.user_error!("build_app produced no archive to verify") if archive.nil? || !File.directory?(archive)
    app = Dir.glob(File.join(archive, "Products", "Applications", "*.app")).first
    UI.user_error!("no .app inside #{archive}") if app.nil?
    plist = File.join(app, "Info.plist")
    bundle_version = sh("/usr/libexec/PlistBuddy", "-c", "Print :CFBundleVersion", plist, log: false).strip
    short_version = sh("/usr/libexec/PlistBuddy", "-c", "Print :CFBundleShortVersionString", plist, log: false).strip

    expected = options[:identity]
    UI.message(
      "archive #{File.basename(archive)}: CFBundleShortVersionString=#{short_version} " \
      "CFBundleVersion=#{bundle_version}; verified manifest " \
      "#{expected['marketingVersion']} (#{expected['buildNumber']})",
    )
    sh(
      "node",
      File.expand_path("../../scripts/release-identity.mjs", __dir__),
      "--check",
      "--require-committed",
      "--assert-version",
      short_version,
      "--assert-build",
      bundle_version,
      log: false,
    )
    UI.success("archive identity matches the verified manifest; upload may proceed")
  end

  private_lane :asc_api_key do
    key_filepath = ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      **(key_filepath ? { key_filepath: key_filepath } : { key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY") }),
    )
  end

  lane :prep_signing do
    api_key = asc_api_key
    get_certificates(
      development: false,
      api_key: api_key,
      output_path: "build/signing",
    )
    get_provisioning_profile(
      api_key: api_key,
      output_path: "build/signing",
    )
  end

  lane :beta do
    api_key = asc_api_key
    # initial_build_number 0 → the very first upload becomes build 1.
    latest_uploaded = latest_testflight_build_number(api_key: api_key, initial_build_number: 0)
    build(latest_uploaded: latest_uploaded)
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end

  lane :release do
    api_key = asc_api_key
    latest_uploaded = latest_testflight_build_number(api_key: api_key, initial_build_number: 0)
    build(latest_uploaded: latest_uploaded)
    upload_to_app_store(
      api_key: api_key,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
    )
  end
end
