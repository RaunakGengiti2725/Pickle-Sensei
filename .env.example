# ── Pickle Sensei — environment template ─────────────────────────────────────
# Copy to .env for local development. NEVER commit real secrets (directive §53).
# Secret ownership: platform/devops owns production values via AWS Secrets
# Manager; local values below are non-secret dev defaults for docker-compose.

# Environment: development | test | staging | production
PICKLE_ENV=development

# services/api
PORT=3001
HOST=127.0.0.1
APP_VERSION=0.1.0

# PostgreSQL (docker-compose defaults; not a real secret)
DATABASE_URL=postgres://pickle:pickle_dev_password@localhost:5432/pickle_dev
# Integration tests only run when this is set (they are skipped otherwise):
# DATABASE_URL_TEST=postgres://pickle:pickle_test_password@localhost:5433/pickle_test

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible local storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=pickle-local
S3_SECRET_ACCESS_KEY=pickle-local-secret
S3_MEDIA_BUCKET=pickle-media-dev

# Queue (ElasticMQ local SQS emulator)
SQS_ENDPOINT=http://localhost:9324

# OIDC (placeholders — real values live in the identity provider config).
# When unset in development/test, the API uses its HS256 dev issuer below;
# staging/production REFUSE to start without real OIDC config.
OIDC_ISSUER=__PLACEHOLDER__
OIDC_AUDIENCE=__PLACEHOLDER__
OIDC_JWKS_URL=__PLACEHOLDER__

# Dev-only token issuer secret (≥16 chars). Never used outside dev/test —
# the verifier construction throws elsewhere.
DEV_AUTH_SECRET=local-dev-secret-change-me

# Store billing credentials (unset ⇒ typed 501s; validation is never faked)
# APPLE_IAP_PRIVATE_KEY=
# GOOGLE_PLAY_SERVICE_ACCOUNT=

# Worker
WORKER_INTERVAL_MS=5000
# SQS_QUEUE_URL=
