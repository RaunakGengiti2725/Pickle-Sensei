          "plane": "linux"
        },
        {
          "from": "@pickle/analysis-pipeline",
          "to": "@pickle/scoring",
          "via": ["packages/scoring/src/engine.ts", "packages/scoring/src/index.ts"],
          "plane": "linux"
        }
      ]
    },
    {
      "id": "sign-in-bootstrap",
