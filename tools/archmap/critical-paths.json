        {
          "from": "PickleVideoCapture native module",
          "to": "native/camera-engine",
          "via": [
            "apps/mobile/ios/LocalPods/PickleNative/Sources/PickleVideoCapture.swift",
            "apps/mobile/ios/LocalPods/PickleNative/Sources/GuidedCaptureViewController.swift",
            "native/camera-engine/Sources/CameraEngine.swift",
            "native/camera-engine/Sources/SessionCaptureCoordinator.swift"
          ],
          "plane": "apple"
        },
        {
          "from": "native/camera-engine",
          "to": "native/vision-core (Apple Vision pose)",
          "via": [
            "native/vision-core/Sources/ApplePoseProvider.swift",
            "native/vision-core/Sources/SessionMotionStream.swift",
            "native/vision-core/Sources/TemporalStrokeDetector.swift",
            "native/vision-core/Sources/VisionCoreContracts.swift"
          ],
          "plane": "apple"
        },
        {
          "from": "native pose stream",
          "to": "@pickle/vision-contracts / @pickle/analysis-pipeline",
          "via": [
            "apps/mobile/src/vision/providers.ts",
