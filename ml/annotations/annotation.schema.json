{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picklesensei.dev/schemas/annotation/v1",
  "title": "Stroke clip annotation (v1)",
  "description": "Formal annotation ontology per blueprint pp. 30-31. Every training/validation clip carries one of these. 'acceptable_alternative_mechanics' prevents the model from learning that every deviation from one reference is a defect.",
  "type": "object",
  "required": [
    "clip_id",
    "shot_type",
    "handedness",
    "camera_view",
    "stroke_start_ms",
    "stroke_end_ms",
    "phases",
    "quality_flags",
    "annotator",
    "revision"
  ],
  "additionalProperties": false,
  "properties": {
    "clip_id": { "type": "string", "minLength": 8 },
    "shot_type": {
      "enum": [
        "serve",
        "return",
        "forehand_drive",
        "backhand_drive",
        "third_shot_drop",
        "dink",
        "volley",
        "overhead"
      ]
    },
    "shot_subtype": { "type": ["string", "null"] },
    "handedness": { "enum": ["right", "left"] },
    "camera_view": { "enum": ["side", "rear_oblique", "other"] },
    "stroke_start_ms": { "type": "integer", "minimum": 0 },
    "stroke_end_ms": { "type": "integer", "minimum": 0 },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "start_ms", "end_ms"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "enum": ["ready", "prepare", "accelerate", "contact", "follow_through", "recover"]
          },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "contact_range_ms": {
      "type": ["object", "null"],
      "required": ["start_ms", "end_ms"],
      "additionalProperties": false,
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "player_bbox": {
      "type": ["object", "null"],
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "minimum": 0, "maximum": 1 },
        "height": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "pose_keyframes": { "type": "array", "items": { "type": "object" } },
    "paddle_keyframes": { "type": "array", "items": { "type": "object" } },
    "ball_keyframes": { "type": "array", "items": { "type": "object" } },
    "court_keypoints": { "type": ["array", "null"], "items": { "type": "object" } },
    "checkpoint_labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["checkpoint", "verdict"],
        "additionalProperties": false,
        "properties": {
          "checkpoint": {
            "enum": [
              "ready_position",
              "athletic_base",
              "preparation",
              "paddle_set",
              "swing_length",
              "sequencing",
              "paddle_path",
              "contact_position",
              "face_wrist_stability",
              "follow_through",
              "recovery"
            ]
          },
          "verdict": { "enum": ["good", "minor_fault", "major_fault", "unobservable"] },
          "fault_direction": {
            "enum": [
              "late",
              "early",
              "high",
              "low",
              "long",
              "short",
              "wide",
              "narrow",
              "open",
              "closed",
              "unstable",
              "none"
            ]
          },
          "fault_severity": { "type": "number", "minimum": 0, "maximum": 1 },
          "note": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "primary_coaching_priority": { "type": ["string", "null"] },
    "acceptable_alternative_mechanics": { "type": "boolean", "default": false },
    "quality_flags": {
      "type": "array",
      "items": {
        "enum": [
          "clean",
          "motion_blur",
          "low_light",
          "partial_occlusion",
          "heavy_occlusion",
          "camera_shake",
          "player_cropped",
          "multiple_people",
          "bad_angle"
        ]
      }
    },
    "occlusion_notes": { "type": ["string", "null"] },
    "annotator": { "type": "string", "minLength": 2 },
    "revision": { "type": "integer", "minimum": 1 },
    "adjudicated_by": { "type": ["string", "null"] },
    "adjudication_note": { "type": ["string", "null"] }
  }
}
